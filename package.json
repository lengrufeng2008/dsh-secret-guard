{
  "name": "dsh-secret-guard",
  "version": "0.1.0",
  "description": "Local-only secret scan and redaction for DeepSeek Harness prompts, logs, diffs, and files. Findings are redacted; no network.",
  "type": "module",
  "bin": { "dsh-secret-guard": "bin/dsh-secret-guard.mjs" },
  "exports": { ".": "./plugin/index.js", "./guard": "./src/guard.mjs", "./plugin": "./plugin/index.js", "./icon": "./icon.svg" },
  "files": ["bin", "src", "plugin", "skills", "icon.svg", "README.md", "NOTICE.md", "LICENSE"],
  "dsh": { "bundle": { "patch": "./plugin/cordis.patch.yml" } },
  "engines": { "node": ">=20" },
  "keywords": ["dsh", "deepseek-harness", "secret", "redaction", "security", "credentials"],
  "license": "MIT",
  "scripts": { "test": "node --test test/*.test.mjs" },
  "repository": { "type": "git", "url": "https://github.com/lengrufeng2008/dsh-secret-guard" }
}
